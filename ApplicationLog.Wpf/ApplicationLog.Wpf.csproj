<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/ApplicationLog.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ApplicationLog.ico" />
    <Using Include="System.IO" />
    <Compile Include="../Library.cs" Link="Shared/Library.cs" />
    <Compile Include="../TextDocument.cs" Link="Shared/TextDocument.cs" />
    <Compile Include="../Preview.cs" Link="Shared/Preview.cs" />
    <None Include="../appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>
</Project>