<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ApplicationLog</AssemblyName>
    <RootNamespace>ApplicationLog</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ApplicationLog.DocumentReaders/ApplicationLog.DocumentReaders.csproj" />
    <Content Include="../ApplicationLog.Wpf/Assets/ApplicationLog.ico" Link="wwwroot/favicon.ico" />
    <Content Include="../ApplicationLog.Wpf/PdfViewer/**/*"
             Exclude="../ApplicationLog.Wpf/PdfViewer/web/applicationlog.js"
             Link="PdfViewer/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="PdfBrowser/applicationlog.js" Link="PdfViewer/web/applicationlog.js"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>